; Runefall (Godot 4.7)
config_version=5

[application]
config/name="Runefall"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Match. Discover. Awaken."
config/icon="res://assets/runefall/runefall_icon_512.png"
boot_splash/bg_color=Color(0.05,0.03,0.13,1)
boot_splash/image="res://assets/runefall/runefall_splash.png"

[display]
window/size/viewport_width=720
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]
theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
fonts/dynamic_fonts/use_oversampling=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.1, 1)
textures/vram_compression/import_etc2_astc=true